pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'brasil-burger'
        DOCKER_TAG = "${env.BUILD_NUMBER}"
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
            }
        }
        stage('Test') {
            steps {
                sh "docker run --rm ${DOCKER_IMAGE}:${DOCKER_TAG} dotnet --version"
            }
        }
        stage('Deploy') {
            steps {
                sh "docker stop brasil-burger-current || true"
                sh "docker rm brasil-burger-current || true"
                sh "docker run -d -p 8080:8080 --name brasil-burger-current ${DOCKER_IMAGE}:${DOCKER_TAG}"
            }
        }
    }
    post {
        success { echo 'Pipeline terminé avec succès !' }
        failure { echo 'Échec du pipeline.' }
    }
}
